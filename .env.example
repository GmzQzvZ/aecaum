# Configuración de Base de Datos
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=aecaum_db

# Configuración de JWT
JWT_SECRET=your_jwt_secret_key_here

# Configuración de SMTP (PHPMailer)
SMTP_HOST=smtp.gmail.com
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_PORT=465
SMTP_SECURE=ssl
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=Soporte AECA Última Milla
# Correos adicionales para recibir una copia de cada mensaje de contacto (opcional, puede ser 1 o 2 emails)
CONTACT_COPY_EMAILS=correo1@ejemplo.com, correo2@ejemplo.com
